# Clawith Environment Variables
# Copy this file to .env and fill in the values

# Security
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Database (auto-configured by setup.sh; override for custom setups)
# For local dev, ssl=disable is required to prevent asyncpg SSL negotiation hang
# DATABASE_URL=postgresql+asyncpg://clawith:clawith@localhost:5432/clawith?ssl=disable

# Redis
# REDIS_URL=redis://localhost:6379/0

# Proactive Agent heartbeat is opt-in. This global switch does not affect
# explicit cron/interval/webhook/on_message triggers.
HEARTBEAT_ENABLED=false
TRIGGER_DAEMON_ENABLED=true
USER_AUTOMATION_EXECUTION_ENABLED=true
USER_SCHEDULE_EXECUTION_ENABLED=false
USER_TASK_EXECUTION_ENABLED=false
APPROVAL_EXECUTION_ENABLED=true
SUPERVISION_EXECUTION_ENABLED=false
OKR_AUTOMATION_ENABLED=false
FEISHU_WEBHOOK_ENABLED=false
TEAMS_WEBHOOK_ENABLED=false

# Code execution is independently gated at platform, company, and Agent level.
# Keep disabled until an approved external sandbox and tenant UUID allowlist
# have passed the production security preflight. Wildcards are not accepted.
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_ALLOWED_TENANT_IDS=
CODE_EXECUTION_ALLOWED_TOOL_NAMES=
CODE_EXECUTION_ALLOWED_SANDBOX_TYPES=
CODE_EXECUTION_ALLOWED_SANDBOX_ENDPOINTS=
CODE_EXECUTION_REQUIRE_APPROVAL=true
SANDBOX_ALLOW_NETWORK=false
SANDBOX_ALLOW_UNSAFE_FALLBACK_WHEN_BWRAP_MISSING=false

# Durable async media recovery.
# MEDIA_GENERATION_POLL_INTERVAL_SECONDS=15
# MEDIA_GENERATION_BATCH_SIZE=20
# MEDIA_GENERATION_SUBMISSION_TIMEOUT_SECONDS=600
# MEDIA_GENERATION_MAX_AGE_SECONDS=172800
# MEDIA_GENERATION_MAX_CONSECUTIVE_ERRORS=12
# MEDIA_GENERATION_RECONCILIATION_CONCURRENCY=1
# MEDIA_GENERATION_TASK_LEASE_SECONDS=1800
# MEDIA_GENERATION_BRAND_RECOVERY_RETENTION_DAYS=30
DELIVERABLE_CREATIVE_QUALITY_GATE_REQUIRED=false
DELIVERABLE_CREATIVE_QUALITY_GATE_TENANT_IDS=
DELIVERABLE_CREATIVE_QUALITY_GATE_AGENT_IDS=
PRODUCTION_ISSUE_MONITOR_ENABLED=true
# PRODUCTION_ISSUE_MONITOR_INTERVAL_SECONDS=30
# PRODUCTION_ISSUE_ALERT_THRESHOLD=1
# PRODUCTION_ISSUE_RETENTION_DAYS=30
# PRODUCTION_ISSUE_ALERT_WEBHOOK_URL=
# MINIMAX_QUOTA_MONITOR_INTERVAL_SECONDS=300

# LangGraph Runtime and native multi-Agent model configuration.
# Both multi-Agent model IDs must reference enabled platform models
# (llm_models.tenant_id IS NULL); they never fall back to a business Agent model.
# MULTI_AGENT_PLANNING_MODEL_ID=<platform-llm-model-uuid>
# MULTI_AGENT_COMPACT_MODEL_ID=<platform-llm-model-uuid>
# AGENT_RUNTIME_SESSION_COMPACT_SCAN_SECONDS=5
# AGENT_RUNTIME_SESSION_COMPACT_SCAN_BATCH_SIZE=50

# Feishu OAuth (optional, for SSO login)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/auth/feishu/callback

# Agent workspace data directory.
# Default: local host -> ~/.clawith/data/agents ; container runtime -> /data/agents
# AGENT_DATA_DIR=

# File storage backend. Use "s3" for S3-compatible object storage.
# When STORAGE_BACKEND=s3, local fallback lets old files under STORAGE_LOCAL_ROOT
# be read and copied into S3 on first access during migration.
# STORAGE_BACKEND=local
# STORAGE_LOCAL_ROOT=
# STORAGE_LOCAL_FALLBACK_ENABLED=true
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=agents
# S3_MAX_POOL_CONNECTIONS=50
# S3_WRITE_WORKERS=32

# Google Cloud Storage (S3-compatible API) — set these instead of MinIO values:
# STORAGE_BACKEND=s3
# S3_BUCKET=your-gcs-bucket-name
# S3_REGION=auto
# S3_ENDPOINT_URL=https://storage.googleapis.com
# S3_ACCESS_KEY_ID=your-hmac-access-key
# S3_SECRET_ACCESS_KEY=your-hmac-secret
# S3_PREFIX=agents


API_PORT=8000

# Jina AI API key (for jina_search and jina_read tools — get one at https://jina.ai)
# Without a key, the tools still work but with lower rate limits
JINA_API_KEY=

# Exa API key (for exa_search tool and web_search Exa engine — get one at https://exa.ai)
EXA_API_KEY=

# Public app URL used in user-facing links, such as password reset emails.
# Leave empty for auto-discovery from the browser request.
# Set explicitly for production (e.g. https://your-domain.com) — required for
# background tasks like webhook URLs and email links that have no request context.
PUBLIC_BASE_URL=

# Optional explicit egress proxy for credentialed Provider API calls. Keep
# empty unless the deployment network requires a proxy to reach Provider APIs.
# Do not commit proxy credentials. The production compose passes this value to
# both API and worker processes, while the application allowlists destinations.
HTTP_PROXY=


# Password reset token lifetime in minutes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend port (default: 3008)
# FRONTEND_PORT=3008

# API upstream for nginx proxy (default: backend:8000)
# API_UPSTREAM=backend:8000

# Valid Debian package mirror DNS hostname for backend image builds
# CLAWITH_APT_MIRROR=mirrors.aliyun.com

# Python pip index URL (for China mirrors)
# CLAWITH_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# CLAWITH_PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
